# Bu dosyanın kopyasını ".env" adıyla oluştur ve kendi bilgilerini yaz.
# .env GitHub'a gönderilmez, .env.example gönderilir.

# Biçim: postgresql+psycopg://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
DATABASE_URL=postgresql+psycopg://postgres:SIFREN@localhost:5432/konu_kartlari

# Giriş jetonlarını imzalayan gizli anahtar (zorunlu). Uzun, rastgele bir yazı olsun. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_GIZLI_ANAHTAR=BURAYA_RASTGELE_UZUN_BIR_YAZI

# Yapay zekâ (Google AI Studio'dan alınır: aistudio.google.com)
GEMINI_API_KEY=BURAYA_KENDI_ANAHTARIN
# İsteğe bağlı, yazılmazsa gemini-flash-lite-latest kullanılır (gemini-3.8-flash ücretsiz katmanda çok yoğun)
GEMINI_MODEL=gemini-flash-lite-latest

# İsteğe bağlı: bir öğrencinin günde kaç kez Gemini kullanabileceği, yazılmazsa 10
# GUNLUK_YZ_HAKKI=10

# İsteğe bağlı: Gemini isteğine en fazla kaç saniye beklensin (yazılmazsa 30). Süre dolunca sistem havuz / yedek haritaya geçer.
# GEMINI_ZAMAN_ASIMI=30

# İsteğe bağlı: sunucu testleri için AYRI veritabanı (tests/test_sunucu.py). Adında "test" geçmeli,
# bu bilgisayarda (localhost) olmalı. Testler bu veritabanını silip yeniden kurar, asıl veritabanını yazma!
# TEST_DATABASE_URL=postgresql+psycopg://postgres:SIFREN@localhost:5432/konu_kartlari_test
